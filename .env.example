# Copy this file to .env and fill in real values. Do NOT commit .env.

# Polygon escrow contract (deploy from contracts/USDCEscrow.sol)
ESCROW_CONTRACT_ADDRESS=0x...

# Wallet that receives platform fees (must match the _platform constructor arg)
PLATFORM_WALLET_ADDRESS=0x...

# Platform fee in basis points (50 = 0.5%)
PLATFORM_FEE_BPS=50

# Server
HOST=127.0.0.1
PORT=8000

# Polygon RPC (free public endpoint by default)
POLYGON_RPC_URL=https://polygon-rpc.com

# Set to true only in dev
DEBUG=false
